# Utility command for install/local

build _deps\sdl2-build\CMakeFiles\install\local.util: CUSTOM_COMMAND _deps\sdl2-build\all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\TurnHub\Include\shared\simulator\build-win\_deps\sdl2-build && "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

