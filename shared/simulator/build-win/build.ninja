  LANGUAGE_COMPILE_FLAGS = /DWIN32 /D_WINDOWS   -DSDL_BUILD_MAJOR_VERSION=2 -DSDL_BUILD_MINOR_VERSION=32 -DSDL_BUILD_MICRO_VERSION=4 /O2 /Ob2 /DNDEBUG -MD
  LINK_FLAGS = /machine:x64 /INCREMENTAL:NO  /NODEFAULTLIB
  LINK_LIBRARIES = kernel32.lib  user32.lib  gdi32.lib  winmm.lib  imm32.lib  ole32.lib  oleaut32.lib  version.lib  uuid.lib  advapi32.lib  setupapi.lib  shell32.lib  dinput8.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = _deps\sdl2-build\CMakeFiles\SDL2.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_COMPILE_PDB = _deps\sdl2-build\CMakeFiles\SDL2.dir\
  TARGET_FILE = bin\SDL2.dll
  TARGET_IMPLIB = _deps\sdl2-build\SDL2.lib
  TARGET_PDB = bin\SDL2.pdb
  RSP_FILE = CMakeFiles\SDL2.rsp


#############################################
# Utility command for uninstall

build _deps\sdl2-build\uninstall: phony _deps\sdl2-build\CMakeFiles\uninstall


#############################################
# Utility command for test

build _deps\sdl2-build\CMakeFiles\test.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\TurnHub\Include\shared\simulator\build-win\_deps\sdl2-build && "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\ctest.exe" --force-new-ctest-process "
  DESC = Running tests...
  pool = console
  restat = 1

build _deps\sdl2-build\test: phony _deps\sdl2-build\CMakeFiles\test.util


#############################################
# Utility command for edit_cache

build _deps\sdl2-build\CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\TurnHub\Include\shared\simulator\build-win\_deps\sdl2-build && "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build _deps\sdl2-build\edit_cache: phony _deps\sdl2-build\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build _deps\sdl2-build\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\TurnHub\Include\shared\simulator\build-win\_deps\sdl2-build && "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" --regenerate-during-build -SD:\TurnHub\Include\shared\simulator -BD:\TurnHub\Include\shared\simulator\build-win"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build _deps\sdl2-build\rebuild_cache: phony _deps\sdl2-build\CMakeFiles\rebuild_cache.util


