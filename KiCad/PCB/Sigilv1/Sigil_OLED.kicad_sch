		)
		(uuid "ed72d4f5-e5d8-5670-b024-bc1879904e5b")
	)
	(text "STATUS RING"
		(exclude_from_sim no)
		(at 290 125 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "fa4f6792-317c-55e0-ac2b-f68c5427388d")
	)
	(text "USB-powered DevKit; J1 / 5V feeds only the status ring (J5).\nJ19 supplies +3V3. All three GND sockets connected.\nOnboard USB-UART, regulator, BOOT and EN retained.\nPAIR is the onboard BOOT button (GPIO0, A6): no carrier wiring; A6 stays NC."
		(exclude_from_sim no)
		(at 28 157 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fdd0307b-692f-58e6-9a54-41630f4bbcb1")
	)
