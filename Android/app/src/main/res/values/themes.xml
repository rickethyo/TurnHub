<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch/manifest theme. Material3 theming (colors, typography) is applied in
      Kotlin by TurnHubTheme (ui/theme/Theme.kt); this XML theme only gives the
      system a window ground matching the default theme (Daylight here, Graphite
      in values-night) so nothing flashes before Compose takes over.
    -->
    <style name="Theme.TurnHub" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>
</resources>
