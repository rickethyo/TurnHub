<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Saved Atlas Wi-Fi passwords never leave this phone. -->
<full-backup-content>
    <exclude domain="sharedpref" path="atlas_wifi.xml" />
    <exclude domain="sharedpref" path="profile_vault.xml" />
        <exclude domain="sharedpref" path="turnhub_atlas_phones.xml" />
        <exclude domain="sharedpref" path="turnhub_rooms.xml" />
        <exclude domain="sharedpref" path="atlas_offline.xml" />
</full-backup-content>
