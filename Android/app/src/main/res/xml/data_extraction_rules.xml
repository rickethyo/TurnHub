<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Saved Atlas Wi-Fi passwords are excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="atlas_wifi.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="atlas_wifi.xml" />
    </device-transfer>
</data-extraction-rules>
