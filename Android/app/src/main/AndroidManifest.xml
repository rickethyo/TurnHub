<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HTTP to Atlas's local API (protocol/http-v1.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Lets requests to Atlas use the Wi-Fi network the user already joined even
      when mobile data stays the default route (Atlas's AP has no internet).
      Read-only: the app never changes Wi-Fi or network settings.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Android 17+ blocks all local-network traffic (including HTTP to
      192.168.4.1) for apps targeting API 37 unless this runtime permission
      ("Nearby devices") is granted; blocked TCP connections just time out.
      Requested when the user taps Connect. Older Android ignores it.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
      Lets the app ask Android to join the Atlas Wi-Fi for its own use
      (WifiNetworkSpecifier via ConnectivityManager.requestNetwork). Android
      shows its own approval dialog; the phone's normal connection is untouched.
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!--
      A quick app switch must not drop the Atlas Wi-Fi: Android releases an
      app's WifiNetworkSpecifier network once the app is no longer foreground.
      AtlasLinkHoldService is a short-lived connectedDevice foreground service
      that keeps the app eligible for LINK_HOLD_MS after it leaves the screen
      (TargetedAtlasWifiLink holds the request; CHANGE_NETWORK_STATE above is
      this service type's prerequisite). The notification says so.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scans the Admin-code QR on the Atlas screen; asked for only when the
         player taps Scan. The camera is optional: typing the code still works. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TurnHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TurnHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".data.AtlasLinkHoldService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
