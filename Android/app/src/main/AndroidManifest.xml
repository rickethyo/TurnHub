<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HTTP to Atlas's local API (protocol/http-v1.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Lets requests to Atlas use the Wi-Fi network the user already joined even
      when mobile data stays the default route (Atlas's AP has no internet).
      Read-only: the app never changes Wi-Fi or network settings.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TurnHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TurnHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
