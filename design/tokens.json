{
  "$comment": "TurnHub design tokens: the single source for the portal (CSS) and the Android app (Kotlin). Edit here, then run python3 design/build_tokens.py. See design/README.md.",
  "themes": {
    "graphite": {
      "label": "Graphite",
      "blurb": "Modern dark. The default on dark devices.",
      "scheme": "dark",
      "display": "text",
      "ornament": "none",
      "color": {
        "bg": "#0A0B0E",
        "surface1": "#14161B",
        "surface2": "#1B1E25",
        "surface3": "#262A33",
        "fill": "#FFFFFF12",
        "fillStrong": "#FFFFFF24",
        "separator": "#FFFFFF1A",
        "separatorStrong": "#FFFFFF38",
        "text": "#F4F6FA",
        "textSecondary": "#A7AFBC",
        "textTertiary": "#828A99",
        "accent": "#F5B53F",
        "accentPressed": "#DDA02E",
        "onAccent": "#1B1303",
        "accentSoft": "#F5B53F24",
        "turn": "#3DDBB1",
        "onTurn": "#03231A",
        "turnSoft": "#3DDBB129",
        "good": "#45D98A",
        "warning": "#FFA24C",
        "critical": "#FF6B66",
        "info": "#72AEFF",
        "focus": "#8CBBFF",
        "scrim": "#000000A8",
        "glowA": "#00000000",
        "glowB": "#00000000"
      }
    },
    "daylight": {
      "label": "Daylight",
      "blurb": "Modern light. The default on light devices.",
      "scheme": "light",
      "display": "text",
      "ornament": "none",
      "color": {
        "bg": "#F2F3F6",
        "surface1": "#FFFFFF",
        "surface2": "#F7F8FA",
        "surface3": "#EBEDF1",
        "fill": "#0F172A0D",
        "fillStrong": "#0F172A1C",
        "separator": "#0F172A1A",
        "separatorStrong": "#0F172A38",
        "text": "#0D1117",
        "textSecondary": "#4A5260",
        "textTertiary": "#646B78",
        "accent": "#9A5D00",
        "accentPressed": "#7E4C00",
        "onAccent": "#FFFFFF",
        "accentSoft": "#C27A0A1F",
        "turn": "#00775E",
        "onTurn": "#FFFFFF",
        "turnSoft": "#00876A1F",
        "good": "#18794A",
        "warning": "#A35200",
        "critical": "#C72B2B",
        "info": "#1F64C4",
        "focus": "#1F64C4",
        "scrim": "#0D111766",
        "glowA": "#00000000",
        "glowB": "#00000000"
      }
    },
    "brass": {
      "label": "Brass",
      "blurb": "Warm gold and walnut, like the Atlas screen.",
      "scheme": "dark",
      "display": "serif",
      "ornament": "brass",
      "color": {
        "bg": "#110D09",
        "surface1": "#1B1510",
        "surface2": "#241C14",
        "surface3": "#30251A",
        "fill": "#DEB06414",
        "fillStrong": "#DEB06429",
        "separator": "#DEB06433",
        "separatorStrong": "#DEB06470",
        "text": "#F6ECD9",
        "textSecondary": "#C9B594",
        "textTertiary": "#A18F72",
        "accent": "#E2AE4A",
        "accentPressed": "#C9952F",
        "onAccent": "#1C1205",
        "accentSoft": "#E2AE4A24",
        "turn": "#62D6B2",
        "onTurn": "#06231B",
        "turnSoft": "#62D6B229",
        "good": "#93DC8C",
        "warning": "#FFA25C",
        "critical": "#FF7D70",
        "info": "#A6C8EA",
        "focus": "#FFE28F",
        "scrim": "#000000A8",
        "glowA": "#E0A8482B",
        "glowB": "#5FD4B00F"
      }
    },
    "contrast": {
      "label": "High contrast",
      "blurb": "Maximum legibility. Chosen automatically when your device asks for more contrast.",
      "scheme": "dark",
      "display": "text",
      "ornament": "none",
      "color": {
        "bg": "#000000",
        "surface1": "#000000",
        "surface2": "#0E0E0E",
        "surface3": "#1C1C1C",
        "fill": "#FFFFFF1F",
        "fillStrong": "#FFFFFF3D",
        "separator": "#BDBDBD",
        "separatorStrong": "#FFFFFF",
        "text": "#FFFFFF",
        "textSecondary": "#ECECEC",
        "textTertiary": "#D0D0D0",
        "accent": "#FFD400",
        "accentPressed": "#FFE45C",
        "onAccent": "#000000",
        "accentSoft": "#FFD40033",
        "turn": "#00F0D8",
        "onTurn": "#000000",
        "turnSoft": "#00F0D833",
        "good": "#7DFF9B",
        "warning": "#FFB000",
        "critical": "#FF9A9A",
        "info": "#8FD3FF",
        "focus": "#FFFFFF",
        "scrim": "#000000CC",
        "glowA": "#00000000",
        "glowB": "#00000000"
      }
    }
  },
  "defaults": {
    "dark": "graphite",
    "light": "daylight",
    "moreContrast": "contrast"
  },
  "contrast": {
    "$comment": "WCAG 2.2 minimums the generator enforces in every theme. Translucent colors are composited over the background first.",
    "checks": [
      ["text", "bg", 7.0],
      ["text", "surface3", 7.0],
      ["textSecondary", "surface2", 4.5],
      ["textTertiary", "surface2", 3.0],
      ["onAccent", "accent", 4.5],
      ["onTurn", "turn", 4.5],
      ["accent", "surface1", 4.5],
      ["turn", "surface1", 4.5],
      ["good", "surface1", 4.5],
      ["warning", "surface1", 4.5],
      ["critical", "surface1", 4.5],
      ["info", "surface1", 4.5],
      ["focus", "bg", 3.0],
      ["separatorStrong", "surface1", 1.6]
    ]
  },
  "font": {
    "text": {
      "family": "Inter",
      "file": "Inter-Variable",
      "fallback": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
    },
    "serif": {
      "family": "Cinzel",
      "file": "Cinzel-Variable",
      "fallback": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif"
    },
    "mono": {
      "fallback": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    }
  },
  "type": {
    "$comment": "size and line in px (sp on Android), tracking in em. Numbers use tabular figures where marked.",
    "caption": {"size": 12, "line": 16, "weight": 500, "tracking": 0.01},
    "footnote": {"size": 13, "line": 18, "weight": 400, "tracking": 0},
    "subhead": {"size": 15, "line": 20, "weight": 400, "tracking": -0.005},
    "body": {"size": 16, "line": 24, "weight": 400, "tracking": -0.01},
    "headline": {"size": 16, "line": 22, "weight": 600, "tracking": -0.01},
    "eyebrow": {"size": 12, "line": 16, "weight": 600, "tracking": 0.08},
    "title3": {"size": 20, "line": 26, "weight": 600, "tracking": -0.015},
    "title2": {"size": 24, "line": 30, "weight": 650, "tracking": -0.02},
    "title1": {"size": 30, "line": 36, "weight": 700, "tracking": -0.022},
    "largeTitle": {"size": 36, "line": 42, "weight": 750, "tracking": -0.025},
    "clock": {"size": 56, "line": 60, "weight": 650, "tracking": -0.03, "tabular": true},
    "hero": {"size": 72, "line": 76, "weight": 700, "tracking": -0.035, "tabular": true},
    "mega": {"size": 112, "line": 112, "weight": 750, "tracking": -0.04, "tabular": true}
  },
  "space": {"0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64},
  "radius": {"xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "full": 999},
  "elevation": {
    "$comment": "Shadows per scheme: [y, blur, spread, alpha] layers. Android uses the dp in 'android'.",
    "dark": {
      "1": [[1, 2, 0, 0.35], [0, 0, 0, 0]],
      "2": [[8, 24, -8, 0.55], [2, 6, -2, 0.35]],
      "3": [[24, 64, -16, 0.7], [6, 16, -6, 0.4]]
    },
    "light": {
      "1": [[1, 2, 0, 0.08], [0, 0, 0, 0]],
      "2": [[8, 24, -10, 0.18], [2, 6, -2, 0.08]],
      "3": [[24, 64, -18, 0.28], [6, 16, -6, 0.12]]
    },
    "android": {"1": 1, "2": 6, "3": 16}
  },
  "motion": {
    "$comment": "Durations in ms. Springs use Compose's dampingRatio and stiffness; the generator approximates them for CSS with linear().",
    "duration": {"instant": 90, "fast": 160, "base": 260, "slow": 420},
    "ease": {
      "standard": [0.2, 0.8, 0.2, 1],
      "enter": [0.0, 0.0, 0.2, 1],
      "exit": [0.4, 0.0, 1, 1]
    },
    "spring": {
      "snappy": {"dampingRatio": 0.82, "stiffness": 700},
      "gentle": {"dampingRatio": 0.9, "stiffness": 240},
      "bouncy": {"dampingRatio": 0.62, "stiffness": 420}
    }
  },
  "layout": {
    "touchTarget": 44,
    "gutter": 16,
    "maxContent": 1200,
    "tabBar": 64
  }
}
