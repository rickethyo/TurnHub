[Unit]
Description=TurnHub Flight Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnhub
WorkingDirectory=/opt/turnhub/PiLogger
ExecStart=/opt/turnhub/PiLogger/.venv/bin/python -m turnhub_logger.main --config /etc/turnhub-flight-recorder.toml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
