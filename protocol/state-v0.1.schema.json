{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnhub.local/schema/state-v0.1.json",
  "title": "TurnHub Authoritative State Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "revision",
    "atlasId",
    "state",
    "players",
    "bootId",
    "settings",
    "sampledAtMs",
    "gameElapsedMs",
    "turnElapsedMs",
    "pending"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "atlasId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "type": "string",
      "enum": [
        "LOBBY",
        "STARTING",
        "RUNNING",
        "PAUSED",
        "GAME_OVER"
      ]
    },
    "hostModuleId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 255
    },
    "starterPlayer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "activePlayer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "winnerPlayer": {
      "description": "Winning player. null in GAME_OVER means the match ended as a draw (Atlas master-button hold).",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "passGraceRemainingMs": {
          "type": "integer",
          "minimum": 0
        },
        "winClaimPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "winConfirmationPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "eliminationTargetPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerNumber",
          "moduleId",
          "slot",
          "eliminated",
          "participantId",
          "turnsCompleted",
          "life",
          "commanderDamage",
          "lifeRequest"
        ],
        "properties": {
          "playerNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "moduleId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "profileId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "eliminated": {
            "type": "boolean"
          },
          "life": {
            "type": [
              "integer",
              "null"
            ]
          },
          "participantId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "turnsCompleted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "commanderDamage": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourcePlayer",
                "damage"
              ],
              "properties": {
                "sourcePlayer": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "damage": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          },
          "lifeRequest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "actor",
              "target",
              "delta",
              "state",
              "requestedAtMs"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "actor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "target": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "delta": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "state": {
                "enum": [
                  "NONE",
                  "PENDING",
                  "ACCEPTED",
                  "REJECTED",
                  "AUTOMATIC",
                  "CANCELLED",
                  "FAILED"
                ]
              },
              "requestedAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      },
      "maxItems": 16
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9A-F]{32}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "startingLife"
      ],
      "properties": {
        "profile": {
          "enum": [
            "generic",
            "mtg",
            "mtg_commander",
            "yugioh"
          ]
        },
        "startingLife": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "turnTimerMs": {
          "description": "Per-turn countdown captured for the match (lobby: the next match). 0 = OFF; otherwise 15000-3600000 in whole seconds. Absent from Atlas firmware before the turn timer; treat as 0.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "turnTimer": {
      "description": "Sampled like turnElapsedMs: may change without a revision change. Absent from older firmware.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "remainingMs"
      ],
      "properties": {
        "phase": {
          "enum": [
            "NORMAL",
            "WARNING",
            "EXPIRED",
            "LONG_TURN"
          ]
        },
        "remainingMs": {
          "description": "Countdown left in the current turn; null when the timer is OFF or no turn is running. 0 once expired; expiry never passes the turn.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "sampledAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "gameElapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "turnElapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
