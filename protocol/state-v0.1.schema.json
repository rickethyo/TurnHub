{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnhub.local/schema/state-v0.1.json",
  "title": "TurnHub Authoritative State Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "revision",
    "atlasId",
    "state",
    "winnerPlayers",
    "players",
    "bootId",
    "settings",
    "sampledAtMs",
    "gameElapsedMs",
    "turnElapsedMs",
    "pending",
    "turnTimer",
    "nudge"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "atlasId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "type": "string",
      "enum": [
        "LOBBY",
        "STARTING",
        "RUNNING",
        "PAUSED",
        "GAME_OVER"
      ]
    },
    "hostModuleId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 255
    },
    "starterPlayer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "activePlayer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "winnerPlayer": {
      "description": "The first winning player (the winner recorded by Atlas; with a shared Star Commander victory, the lower player number). null in GAME_OVER means the match ended as a draw (End match hold on the Atlas touchscreen, or an elimination batch that left nobody and no Star Commander winner). Every winner is in winnerPlayers.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "winnerPlayers": {
      "description": "Every player who won, ascending: one player, both Two-Headed Giant teammates, or the two allies sharing a Star Commander victory. Empty while no one has won and for a draw. A shared victory is not a draw.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 255
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "passGraceRemainingMs": {
          "type": "integer",
          "minimum": 0
        },
        "winClaimPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "winConfirmationPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 255
        },
        "eliminationTargetPlayer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerNumber",
          "moduleId",
          "slot",
          "eliminated",
          "participantId",
          "turnsCompleted",
          "life",
          "commanderDamage",
          "lifeRequest"
        ],
        "properties": {
          "playerNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "moduleId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "team": {
            "description": "Two-Headed Giant team (1-based; players 1+2 are team 1), previewed in the lobby; null outside Two-Headed Giant. Teammates show the same life, and both have the turn when either is activePlayer.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 8
          },
          "profileId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "eliminated": {
            "type": "boolean"
          },
          "life": {
            "type": [
              "integer",
              "null"
            ]
          },
          "participantId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "turnsCompleted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "commanderDamage": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourcePlayer",
                "damage"
              ],
              "properties": {
                "sourcePlayer": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "damage": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          },
          "lifeRequest": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "actor",
              "target",
              "delta",
              "state",
              "requestedAtMs",
              "windowMs"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "actor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "target": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "delta": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "state": {
                "enum": [
                  "NONE",
                  "PENDING",
                  "ACCEPTED",
                  "REJECTED",
                  "AUTOMATIC",
                  "CANCELLED",
                  "FAILED"
                ]
              },
              "requestedAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "windowMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 65535,
                "description": "The recipient's approval window; Atlas accepts the request this long after requestedAtMs."
              }
            }
          },
          "conceded": {
            "type": "boolean",
            "description": "Voluntary concession; eliminated remains true for all removed players."
          },
          "counters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "poison",
              "energy",
              "experience",
              "commanderCasts",
              "cityBlessing"
            ],
            "properties": {
              "poison": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "energy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "experience": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "commanderCasts": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "cityBlessing": {
                "type": "boolean"
              },
              "treasure": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "rad": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "description": "Shared team poison in 2HG; other values belong to this player. Commander tax is twice each command-zone cast count. Treasure and rad (CR 727) are per player and optional in older captures."
          },
          "radDue": {
            "description": "Magic: this player's rad counters triggered as their turn began and they haven't said yet how many of the milled cards were nonlands (counter rad-resolve).",
            "type": "boolean"
          },
          "eliminatedBy": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 16,
            "description": "Explicitly credited opponent player number for this elimination; null for unknown or concession. Independent of controller and current turn."
          },
          "selfEliminated": {
            "type": "boolean",
            "description": "Explicit Self / own team answer. No opponent receives credit."
          },
          "eliminationPending": {
            "type": "boolean",
            "description": "An automatic removal awaits explicit opponent, Self or Unknown attribution; the game is paused and completion/statistics are deferred."
          },
          "commander": {
            "description": "Commander formats: the commander this player chose from their profile's saved ones (lobby), or plays (match). Null for none; absent from older firmware.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "name",
              "art"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "art": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 48
              }
            }
          }
        }
      },
      "maxItems": 16
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9A-F]{32}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "startingLife"
      ],
      "properties": {
        "profile": {
          "enum": [
            "generic",
            "mtg",
            "mtg_commander",
            "yugioh",
            "mtg_star_commander",
            "mtg_bag_of_doom"
          ]
        },
        "startingLife": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "turnTimerMs": {
          "description": "Per-turn countdown captured for the match (lobby: the next match). 0 = OFF; otherwise 15000-3600000 in whole seconds. Absent from Atlas firmware before the turn timer; treat as 0.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "twoHeadedGiant": {
          "description": "Two-Headed Giant (mtg and mtg_commander only, never mtg_star_commander or mtg_bag_of_doom): teams of two neighbours in turn order (players 1+2, 3+4, ...) share one life total and one turn; either teammate may pass. startingLife is the team total. Absent from older firmware; treat as false.",
          "type": "boolean"
        },
        "houseRules": {
          "description": "Official modes (mtg 20 life/10 poison, mtg_commander 40/10, Two-Headed Giant mtg 30/15 with exactly 4 players, yugioh 8000 with exactly 2 players) keep those values unless house rules are on. Absent from older firmware; treat as false.",
          "type": "boolean"
        },
        "autoEliminateAtZeroLife": {
          "type": "boolean",
          "description": "Eliminate living players at zero or negative life; editable during play."
        },
        "autoEliminateAtPoisonLimit": {
          "type": "boolean"
        },
        "autoEliminateAtCommanderDamage": {
          "type": "boolean"
        },
        "poisonLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "askEliminationSource": {
          "type": "boolean",
          "description": "App-started games pause automatic removals until an explicit source is recorded, before completion/statistics. Bag of Doom always enables this."
        },
        "planechase": {
          "description": "Planechase with the players' own plane cards (Magic formats; lobby: the next match). Absent from older Atlas firmware; treat as false.",
          "type": "boolean"
        },
        "planarDeck": {
          "description": "Planechase's deck: the players' own planes, or Atlas's digital deck (it falls back to physical with no saved catalog). Absent from older firmware; treat as physical.",
          "enum": [
            "physical",
            "digital"
          ]
        }
      }
    },
    "turnTimer": {
      "description": "Sampled like turnElapsedMs: may change without a revision change. Absent from older firmware.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "remainingMs"
      ],
      "properties": {
        "phase": {
          "enum": [
            "NORMAL",
            "WARNING",
            "EXPIRED",
            "LONG_TURN"
          ]
        },
        "remainingMs": {
          "description": "Countdown left in the current turn; null when the timer is OFF or no turn is running. 0 once expired; expiry never passes the turn.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "sampledAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "gameElapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "turnElapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "shortGameUncounted": {
      "description": "GAME_OVER only: the match lasted under a minute of play and is not in profile statistics until a seated player sends count-game. Absent from older firmware; treat as false.",
      "type": "boolean"
    },
    "nudge": {
      "description": "The last nudge since Atlas booted (POST /api/control/nudge), or null. A client alerts the toPlayer when seq grows.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "seq",
        "fromPlayer",
        "toPlayer",
        "ageMs"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "fromPlayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "toPlayer": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "ageMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "game": {
      "description": "Venue tables (since 2026-10-07): the game on this Atlas this snapshot describes, 1-based. A signed-in client sees the game its profile plays in, else the one it follows (POST /api/session/game); a client without a session may ask with ?game=N.",
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "games": {
      "description": "One line per game on this Atlas, for a game switch.",
      "type": "array",
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game",
          "state",
          "players"
        ],
        "properties": {
          "game": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "state": {
            "type": "string",
            "enum": [
              "LOBBY",
              "STARTING",
              "RUNNING",
              "PAUSED",
              "GAME_OVER"
            ]
          },
          "players": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "battery": {
      "description": "Atlas's own battery, estimated from the cell voltage: sampled like turnElapsedMs, so it may change without a revision change. null with no cell; absent from older firmware.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "percent",
        "low",
        "charging"
      ],
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "low": {
          "description": "At or below 15 % (clears at 20 %).",
          "type": "boolean"
        },
        "charging": {
          "description": "On USB with a cell and below 100: the board's charger is filling it, and percent counts up. False once full.",
          "type": "boolean"
        }
      }
    },
    "monarchPlayer": {
      "description": "The single living monarch in a Magic game, or null. Individual player number, including in team games.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 255
    },
    "initiativePlayer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 16,
      "description": "The one living initiative holder in a Magic game, independent of monarch."
    },
    "dayNight": {
      "description": "Magic and Commander formats: the table's day or night (CR 726), set by hand from any living player's controls; null for formats without it. Resets with each new match.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NEITHER",
        "DAY",
        "NIGHT",
        null
      ]
    },
    "turnOrderReversed": {
      "description": "Turns go counterclockwise (a card reversed them) until a player sets them back; Two-Headed Giant still passes team to team. False at each new match.",
      "type": "boolean"
    },
    "doomBag": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "atRisk",
        "drawn",
        "boundary",
        "warmup",
        "cycle",
        "pending",
        "pendingTurn",
        "sealed",
        "lastDraw",
        "lastCheck"
      ],
      "properties": {
        "atRisk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "drawn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "boundary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "warmup": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "pending": {
          "type": "boolean"
        },
        "pendingTurn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "sealed": {
          "type": "boolean"
        },
        "lastDraw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "lastCheck": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "Bag of Doom only, after match start. Player masks use bit (playerNumber - 1); 0 in player fields means none. A sealed draw must retry the same reserved selection, which is never exposed here. Each completed check increments cycle and refills immunity."
    },
    "planechase": {
      "description": "Planechase in this match: the players' own plane cards, or Atlas's digital deck dealt from the plane catalog the app saved (GET/POST /api/planes). Atlas counts the planar die's cost, chaos and planeswalks. Null when off or between matches.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source",
        "planeswalks",
        "chaos",
        "counters",
        "rollCost",
        "lastRoll",
        "plane",
        "deckSize"
      ],
      "properties": {
        "source": {
          "enum": [
            "physical",
            "digital"
          ]
        },
        "planeswalks": {
          "type": "integer",
          "minimum": 0
        },
        "chaos": {
          "type": "integer",
          "minimum": 0
        },
        "counters": {
          "description": "Counters on the face-up plane.",
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "rollCost": {
          "description": "Mana the active player's next planar die roll costs this turn.",
          "type": "integer",
          "minimum": 0
        },
        "lastRoll": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "number",
            "player",
            "face",
            "cost",
            "fromEffect"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "player": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "face": {
              "enum": [
                "blank",
                "chaos",
                "planeswalk"
              ]
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "fromEffect": {
              "type": "boolean"
            }
          }
        },
        "plane": {
          "description": "Digital: the face-up card; name is null when the catalog no longer has it.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "phenomenon"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "phenomenon": {
              "type": "boolean"
            }
          }
        },
        "deckSize": {
          "description": "Digital: cards left face down; 0 for physical planes.",
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
