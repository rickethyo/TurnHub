{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnhub.local/schema/state-v0.1.json",
  "title": "TurnHub Authoritative State Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "revision", "atlasId", "state", "players"],
  "properties": {
    "protocolVersion": {"const": "0.1"},
    "revision": {"type": "integer", "minimum": 0},
    "atlasId": {"type": "string", "minLength": 1, "maxLength": 64},
    "state": {
      "type": "string",
      "enum": ["LOBBY", "STARTING", "RUNNING", "PAUSED", "GAME_OVER"]
    },
    "hostModuleId": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "starterPlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
    "activePlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
    "winnerPlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passPlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
        "passGraceRemainingMs": {"type": "integer", "minimum": 0},
        "winClaimPlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255},
        "winConfirmationPlayer": {"type": ["integer", "null"], "minimum": 1, "maximum": 255}
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["playerNumber", "moduleId", "slot", "eliminated"],
        "properties": {
          "playerNumber": {"type": "integer", "minimum": 1, "maximum": 255},
          "moduleId": {"type": "integer", "minimum": 0, "maximum": 255},
          "slot": {"type": "integer", "minimum": 0, "maximum": 255},
          "profileId": {"type": ["string", "null"], "maxLength": 64},
          "displayName": {"type": ["string", "null"], "maxLength": 64},
          "eliminated": {"type": "boolean"},
          "life": {"type": ["integer", "null"]}
        }
      }
    }
  }
}
