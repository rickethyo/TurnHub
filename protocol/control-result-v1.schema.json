{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnHub session control result with state metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "status",
    "bootId",
    "revision"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "CONFLICT"
      ]
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9A-F]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
