{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnHub HTTP API v1 metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "deviceType",
    "atlasId",
    "firmwareVersion",
    "apiVersion",
    "protocolVersion",
    "radioProtocolVersion",
    "bootId",
    "revision",
    "capabilities"
  ],
  "properties": {
    "product": {
      "const": "TurnHub"
    },
    "deviceType": {
      "const": "Atlas"
    },
    "atlasId": {
      "type": "string",
      "minLength": 1
    },
    "firmwareVersion": {
      "type": "string"
    },
    "apiVersion": {
      "const": "1"
    },
    "protocolVersion": {
      "description": "1: Atlas is an accessory to a phone hub (atlas-state-v1, hosted-v1.md). 0.1 was the retired Atlas-run game state.",
      "const": "1"
    },
    "radioProtocolVersion": {
      "description": "Atlas-Sigil ESP-NOW protocol version (3 since the baseline Sigil, 2026-09-30; 2 was the secure link). Informational: clients do not use the radio.",
      "type": "integer",
      "minimum": 1
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9A-F]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateSnapshot",
        "sessionControls",
        "intentEnvelope",
        "events",
        "requestDeduplication"
      ],
      "properties": {
        "stateSnapshot": {
          "type": "boolean"
        },
        "sessionControls": {
          "type": "boolean"
        },
        "intentEnvelope": {
          "type": "boolean"
        },
        "events": {
          "type": "boolean"
        },
        "requestDeduplication": {
          "type": "boolean"
        }
      }
    },
    "home": {
      "description": "Where phones reach this Atlas on the home network over HTTPS (HOME_WIFI.md), or null when Atlas is not on one. Clients pin tlsPin (lower-case hex SHA-256 of the key's SubjectPublicKeyInfo) only when they read it over Atlas's own hotspot.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "tlsPort",
            "tlsPin"
          ],
          "properties": {
            "address": {
              "type": "string",
              "minLength": 7
            },
            "tlsPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tlsPin": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
